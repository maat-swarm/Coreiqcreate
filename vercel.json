{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://coreiqcreate.onrender.com/api/v1/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://coreiqcreate.onrender.com/mcp"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "https://coreiqcreate.onrender.com/mcp/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
